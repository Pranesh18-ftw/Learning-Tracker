# Firebase Web App Configuration Template
# Copy this file to .env.local and fill in the values from your Firebase Console
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Server-Side Netlify Functions Configuration (Set in Netlify Dashboard / Runtime Environment ONLY)
# Never expose these in React frontend or commit actual values to git!
#
# Option A: Single JSON Service Account Key
# FIREBASE_SERVICE_ACCOUNT_KEY=
#
# Option B: Discrete Service Account Credentials (Supported directly by Netlify Dashboard)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
#
# Server-Side Cryptographic Pepper for Device Pairing (Mandatory in Production)
# PAIRING_SECRET_PEPPER=