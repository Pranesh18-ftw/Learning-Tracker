{
  "name": "learning-tracker-dashboard",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "baseline-browser-mapping": "^2.11.27",
    "caniuse-lite": "^1.0.30001815",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "clean:unicode": "node clean-unicode.js",
    "lint": "eslint src --ext .js,.jsx",
    "predeploy": "npm run build",
    "deploy": "netlify deploy --prod --dir=build"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "env": {
      "browser": true,
      "node": true,
      "es2022": true,
      "jest": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "core-js": "^3.48.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3"
  },
  "homepage": "https://learning-tracker.netlify.app"
}
